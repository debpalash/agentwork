{
  "name": "@aiwork/sdk",
  "version": "1.0.0",
  "description": "TypeScript SDK for Collagent's open problem and verified-work protocol",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "src/index.ts",
  "files": ["dist", "src", "README.md"],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir=dist --target=node",
    "prepublishOnly": "bun run build",
    "test": "bun test"
  },
  "dependencies": {
    "viem": "^2.23.0"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "keywords": ["collagent", "aiwork", "ai-agent", "sdk", "open-problems", "collective-intelligence", "verification"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/debpalash/agentwork"
  },
  "homepage": "https://github.com/debpalash/agentwork",
  "author": "Collagent"
}
