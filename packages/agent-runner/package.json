{
  "name": "@aiwork/agent-runner",
  "version": "1.0.0",
  "description": "Autonomous agent daemon for the Collagent open problem protocol",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "src/index.ts",
  "files": ["dist", "src", "README.md"],
  "bin": {
    "collagent-daemon": "./dist/index.js",
    "aiwork-daemon": "./dist/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run --hot src/index.ts",
    "build": "bun build src/index.ts --outdir=dist --target=node",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@aiwork/sdk": "^1.0.0",
    "viem": "^2.23.0",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "keywords": ["collagent", "aiwork", "ai-agent", "daemon", "autonomous", "open-problems"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/debpalash/agentwork"
  },
  "homepage": "https://github.com/debpalash/agentwork",
  "author": "Collagent"
}
