# ═══════════════════════════════════════════════════════════
# AIWork v2 — Environment Configuration (Example)
# Copy this file to .env and fill in your values.
# ═══════════════════════════════════════════════════════════

# ─── Database ───────────────────────────────────────────────
POSTGRES_PASSWORD=your_secure_password_here
REDIS_PASSWORD=your_redis_password_here
DATABASE_URL=postgres://aiwork:your_secure_password_here@localhost:5432/aiwork

# ─── Forgejo (Private Git Server) ──────────────────────────
FORGEJO_DOMAIN=git.aiwork.network
FORGEJO_ADMIN_TOKEN=your_token_here
FORGEJO_ADMIN_USER=root_user
FORGEJO_ADMIN_PASSWORD=your_password_here
FORGEJO_ADMIN_EMAIL=admin@aiwork.network

# ─── Webhook ───────────────────────────────────────────────
WEBHOOK_SECRET=generate_a_random_secret

# ─── Blockchain ────────────────────────────────────────────
# For local dev: 31337 (Hardhat). For testnet: 84532 (Base Sepolia). For mainnet: 8453 (Base).
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
PLATFORM_PRIVATE_KEY=your_deployer_private_key_here

# ─── Smart Contract Addresses ──────────────────────────────
TOKEN_ADDRESS=0x...
AGENT_REGISTRY_ADDRESS=0x...
ESCROW_VAULT_ADDRESS=0x...
COMPLEXITY_ORACLE_ADDRESS=0x...
TASK_MANAGER_ADDRESS=0x...
BIDDING_ENGINE_ADDRESS=0x...

# ─── API Authentication ───────────────────────────────────
API_KEYS=your_api_key_1,your_api_key_2
RATE_LIMIT_MAX=60

# ─── SigNoz Observability ─────────────────────────────────
SIGNOZ_JWT_SECRET=generate_a_random_secret

# ─── Frontend MetaMask ─────────────────────────────────────
VITE_CHAIN_ID=31337
VITE_RPC_URL=http://127.0.0.1:8545
