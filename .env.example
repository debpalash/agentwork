# ═══════════════════════════════════════════════════════════
# Collagent — Environment Configuration (Example)
# Copy this file to .env and fill in your values.
# AIWORK_* deployment variables remain supported compatibility identifiers.
# ═══════════════════════════════════════════════════════════

# ─── Database ───────────────────────────────────────────────
POSTGRES_PASSWORD=your_secure_password_here
REDIS_PASSWORD=your_redis_password_here
DATABASE_URL=postgres://aiwork:your_secure_password_here@localhost:5432/aiwork

# ─── Forgejo (Private Git Server) ──────────────────────────
FORGEJO_DOMAIN=git.collagent.example
FORGEJO_ROOT_URL=https://git.collagent.example
FORGEJO_ADMIN_TOKEN=your_token_here
FORGEJO_READ_TOKEN=your_read_only_token_here
FORGEJO_ADMIN_USER=root_user
FORGEJO_ADMIN_PASSWORD=your_password_here
FORGEJO_ADMIN_EMAIL=admin@collagent.example

# ─── Builder Clients ───────────────────────────────────────
COLLAGENT_API_URL=http://localhost:3001/api/v1
COLLAGENT_API_KEY=replace_with_scoped_agent_key

# ─── Webhook ───────────────────────────────────────────────
WEBHOOK_SECRET=generate_a_random_secret

# ─── Blockchain ────────────────────────────────────────────
# For local dev: 31337 (Hardhat). For testnet: 84532 (Base Sepolia). For mainnet: 8453 (Base).
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
PLATFORM_PRIVATE_KEY=your_deployer_private_key_here

# ─── Smart Contract Addresses ──────────────────────────────
TOKEN_ADDRESS=0x...
PAYMENT_TOKEN_DECIMALS=6
AGENT_REGISTRY_ADDRESS=0x...
ESCROW_VAULT_ADDRESS=0x...
COMPLEXITY_ORACLE_ADDRESS=0x...
TASK_MANAGER_ADDRESS=0x...
BIDDING_ENGINE_ADDRESS=0x...
DISPUTE_RESOLUTION_ADDRESS=0x...

# Production settlement requires an odd independent verifier quorum and at
# least three bonded, non-party arbiters. Deployment fails closed if absent.
VERIFIER_QUORUM=3
VERIFIER_ADDRESSES=0x...,0x...
VERIFIER_INSTANCE_IDS=verifier-1,verifier-2,verifier-3
ARBITER_ADDRESSES=0x...,0x...,0x...

# Each verifier key must resolve to a distinct VERIFIER_ROLE wallet. Use an
# independent Daytona deployment/read token for each verifier in production.
VERIFIER_1_PRIVATE_KEY=0x...
VERIFIER_1_DAYTONA_API_URL=https://verifier-1.example
VERIFIER_1_DAYTONA_API_KEY=...
VERIFIER_1_FORGEJO_READ_TOKEN=...
VERIFIER_2_PRIVATE_KEY=0x...
VERIFIER_2_DAYTONA_API_URL=https://verifier-2.example
VERIFIER_2_DAYTONA_API_KEY=...
VERIFIER_2_FORGEJO_READ_TOKEN=...
VERIFIER_3_PRIVATE_KEY=0x...
VERIFIER_3_DAYTONA_API_URL=https://verifier-3.example
VERIFIER_3_DAYTONA_API_KEY=...
VERIFIER_3_FORGEJO_READ_TOKEN=...

# Production compose accepts immutable `name:tag@sha256:digest` references.
RELEASE_VERSION=3.0.0-alpha.1
AIWORK_API_IMAGE=registry.example/aiwork-api:3.0.0-alpha.1@sha256:...
AIWORK_FRONTEND_IMAGE=registry.example/aiwork-frontend:3.0.0-alpha.1@sha256:...
POSTGRES_IMAGE=postgres:18-alpine@sha256:...
FORGEJO_IMAGE=codeberg.org/forgejo/forgejo:10@sha256:...
DAYTONA_API_IMAGE=daytonaio/daytona-api:v0.189.0@sha256:...
DAYTONA_RUNNER_IMAGE=daytonaio/daytona-runner:v0.189.0@sha256:...
REDIS_IMAGE=redis:8.2-alpine@sha256:...
MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z@sha256:...
DEX_IMAGE=dexidp/dex:v2.42.0@sha256:...
REGISTRY_IMAGE=registry:2.8.3@sha256:...
CADDY_IMAGE=caddy:2-alpine@sha256:...
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:25.5.6@sha256:...
ZOOKEEPER_IMAGE=signoz/zookeeper:3.7.1@sha256:...
SIGNOZ_IMAGE=signoz/signoz:v0.118.0@sha256:...
SIGNOZ_OTEL_IMAGE=signoz/signoz-otel-collector:v0.144.2@sha256:...
DAYTONA_DEX_CONFIG_PATH=/absolute/path/to/production-dex-config.yaml
DAYTONA_OIDC_ISSUER=https://identity.example/dex
DAYTONA_PUBLIC_OIDC_DOMAIN=https://identity.example/dex
DAYTONA_DASHBOARD_URL=https://sandbox.example

# ─── API Authentication ───────────────────────────────────
API_KEYS=your_api_key_1,your_api_key_2
RATE_LIMIT_MAX=60
ALLOWED_ORIGINS=https://collagent.example
# Relying-party origins allowed inside body-bound wallet signatures.
AUTH_ALLOWED_ORIGINS=https://collagent.example,https://api.collagent.example
TRUST_PROXY=false
SITE_ADDRESS=collagent.example
API_ADDRESS=api.collagent.example
GIT_ADDRESS=git.collagent.example

# ─── SigNoz Observability ─────────────────────────────────
SIGNOZ_JWT_SECRET=generate_a_random_secret

# ─── Frontend MetaMask ─────────────────────────────────────
VITE_CHAIN_ID=31337
VITE_RPC_URL=http://127.0.0.1:8545
VITE_TASK_MANAGER_ADDRESS=0x...
VITE_DISPUTE_RESOLUTION_ADDRESS=0x...
VITE_ESCROW_VAULT_ADDRESS=0x...
VITE_BOND_TOKEN_ADDRESS=0x...
VITE_PAYMENT_TOKEN_ADDRESS=0x...
VITE_PAYMENT_TOKEN_DECIMALS=6
