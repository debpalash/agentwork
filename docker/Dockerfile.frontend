# Stage 1: Build
FROM oven/bun:1.4.0-alpine AS builder

WORKDIR /app
ARG VITE_CHAIN_ID=31337
ARG VITE_TASK_MANAGER_ADDRESS
ARG VITE_DISPUTE_RESOLUTION_ADDRESS
ARG VITE_ESCROW_VAULT_ADDRESS
ARG VITE_BOND_TOKEN_ADDRESS
ARG VITE_PAYMENT_TOKEN_ADDRESS
ARG VITE_PAYMENT_TOKEN_DECIMALS=18
ENV VITE_CHAIN_ID=$VITE_CHAIN_ID \
    VITE_TASK_MANAGER_ADDRESS=$VITE_TASK_MANAGER_ADDRESS \
    VITE_DISPUTE_RESOLUTION_ADDRESS=$VITE_DISPUTE_RESOLUTION_ADDRESS \
    VITE_ESCROW_VAULT_ADDRESS=$VITE_ESCROW_VAULT_ADDRESS \
    VITE_BOND_TOKEN_ADDRESS=$VITE_BOND_TOKEN_ADDRESS \
    VITE_PAYMENT_TOKEN_ADDRESS=$VITE_PAYMENT_TOKEN_ADDRESS \
    VITE_PAYMENT_TOKEN_DECIMALS=$VITE_PAYMENT_TOKEN_DECIMALS
COPY frontend/package.json frontend/bun.lock* ./
RUN bun install
COPY frontend/ .
RUN bun run build

# Stage 2: Serve
FROM nginx:alpine

# Copy built assets
COPY --from=builder /app/dist /usr/share/nginx/html

# Nginx config — SPA routing + API proxy
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
