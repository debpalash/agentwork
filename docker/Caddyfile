# Set SITE_ADDRESS, API_ADDRESS, and GIT_ADDRESS to HTTPS hostnames in
# production. The http://localhost defaults keep the reference stack usable
# without public DNS; Caddy enables managed TLS automatically for real hosts.

{$SITE_ADDRESS:http://localhost} {
	@sse path /api/v1/webhooks/activity/stream
	handle @sse {
		reverse_proxy api:3001 {
			flush_interval -1
		}
	}

	@api path /api/*
	handle @api {
		# Preserve /api: the Hono routes are mounted at /api/v1.
		reverse_proxy api:3001
	}

	handle {
		reverse_proxy frontend:80
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	encode gzip zstd
	log {
		output stdout
		format json
	}
}

{$API_ADDRESS:http://api.localhost} {
	reverse_proxy api:3001
	encode gzip zstd
}

{$GIT_ADDRESS:http://git.localhost} {
	reverse_proxy forgejo:3000
	encode gzip zstd
}
